# Recommendations for ONE assessed entity: ONLY recommend(?ae, ?rp) facts present in the SWRL-inferred graph,
# joined with the explanation record written by the reasoning pipeline.
PREFIX iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#>
PREFIX app: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2-app#>
SELECT ?practice ?practiceName ?practiceDescription ?bp ?bpID ?result ?percentage ?rating
       ?ratingRule ?recommendationRule (GROUP_CONCAT(DISTINCT ?nr; separator="|") AS ?necessaryRules)
       ?evidence ?runAt ?reasoner WHERE {
  GRAPH <urn:iso29110:graph:inferred-swrl> { ?pAssessedEntity iso:recommend ?practice }
  ?practice iso:hasPracticeName ?practiceName ; iso:hasPracticeDescription ?practiceDescription .
  GRAPH <urn:iso29110:graph:explanation> {
    ?exp a app:RecommendationExplanation ; app:assessedEntity ?pAssessedEntity ; app:recommendedPractice ?practice ;
         app:triggeringResult ?result ; app:basePractice ?bp ; app:inferredRating ?rating ;
         app:ratingInference ?rs ; app:recommendationInference ?recs ; app:inReasoningRun ?run .
    OPTIONAL { ?exp app:percentageAchievement ?percentage }
    ?rs app:concludedByRule ?ratingRule .
    ?recs app:concludedByRule ?recommendationRule ; app:necessaryRule ?nr .
    ?run app:runAt ?runAt ; app:reasoner ?reasoner .
  }
  ?bp iso:hasBasePracticeID ?bpID .
  OPTIONAL { ?result iso:hasEvidence ?ev . ?ev iso:hasEvidenceDescription ?evidence }
}
GROUP BY ?practice ?practiceName ?practiceDescription ?bp ?bpID ?result ?percentage ?rating ?ratingRule ?recommendationRule ?evidence ?runAt ?reasoner
ORDER BY ?rating ?bpID
