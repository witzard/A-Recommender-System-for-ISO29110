# Values offered by the search form, read from the ontology (no hard-coded lists).
PREFIX iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#>
SELECT ?type ?value ?label ?parent WHERE {
  { ?x a iso:Process ; iso:hasProcessCode ?code ; iso:hasProcessName ?n .
    BIND("process" AS ?type) BIND(STR(?x) AS ?value) BIND(CONCAT(STR(?n), " (", STR(?code), ")") AS ?label) }
  UNION
  { ?p iso:hasActivity ?x . ?p iso:hasProcessCode ?code . ?x iso:hasActivityID ?id ; iso:hasActivityName ?n .
    BIND("activity" AS ?type) BIND(STR(?x) AS ?value) BIND(CONCAT(STR(?id), " ", STR(?n)) AS ?label) BIND(STR(?code) AS ?parent) }
  UNION
  { SELECT ("role" AS ?type) (STR(?a) AS ?value) (SAMPLE(CONCAT(STR(?n), " (", STR(?a), ")")) AS ?label)
    WHERE { ?r a iso:Role ; iso:hasRoleAbbreviation ?a ; iso:hasRoleName ?n } GROUP BY ?a }
  UNION
  { ?x iso:hasWorkProductID ?id ; iso:hasWorkProductName ?n .
    BIND("workProduct" AS ?type) BIND(STR(?x) AS ?value) BIND(STR(?n) AS ?label) }
  UNION
  { ?x iso:hasWorkProductStateName ?n . FILTER EXISTS { ?o iso:hasFinalState ?x }
    BIND("state" AS ?type) BIND(STR(?x) AS ?value) BIND(STR(?n) AS ?label) }
}
ORDER BY ?type ?label
