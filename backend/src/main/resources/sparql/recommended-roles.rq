# Roles recommended for the assessed entities of one project (?pPj): recommendRole is inferred by Pellet (SWRL).
# ?tasks lists the recommended tasks that the role performs (for display).
PREFIX iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#>
SELECT ?ae ?role ?roleName ?abbr (GROUP_CONCAT(DISTINCT ?taskID; separator=", ") AS ?tasks) WHERE {
  ?ae iso:responsibleFor ?pPj .
  GRAPH <urn:iso29110:graph:inferred> { ?ae iso:recommendRole ?role }
  ?role iso:hasRoleName ?roleName ; iso:hasRoleAbbreviation ?abbr .
  OPTIONAL { GRAPH <urn:iso29110:graph:inferred> { ?ae iso:recommendTask ?t } ?t iso:hasRole ?role ; iso:hasTaskID ?taskID . }
}
GROUP BY ?ae ?role ?roleName ?abbr
