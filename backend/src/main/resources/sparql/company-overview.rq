# Company, project and assessment overview for ONE enterprise (?pEnterprise bound as IRI).
PREFIX iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?name ?profile ?project ?projectName ?projectDescription ?start ?end ?staff
       ?assessment ?assessmentDate ?consultantName ?assessedEntity WHERE {
  ?pEnterprise iso:hasEnterpriseName ?name ; iso:hasProject ?project .
  OPTIONAL { ?pEnterprise rdfs:comment ?profile }
  OPTIONAL { ?project iso:hasProjectName ?projectName }
  OPTIONAL { ?project iso:hasProjectDescription ?projectDescription }
  OPTIONAL { ?project iso:hasStartingDate ?start }
  OPTIONAL { ?project iso:hasEndingDate ?end }
  OPTIONAL { ?project iso:hasNumberofStaff ?staff }
  ?assessedEntity iso:responsibleFor ?project .
  ?assessment iso:hasAssessedEntity ?assessedEntity .
  OPTIONAL { ?assessment iso:hasAssessmentDate ?assessmentDate }
  OPTIONAL { ?consultant iso:preAssess ?assessment ; iso:hasConsultantName ?consultantName }
}
