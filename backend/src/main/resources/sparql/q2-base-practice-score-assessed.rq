PREFIX iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#>
# Score mode "assessed" (2026-11-16): BP score = mean of the scores of its assessed work products only
# (q1-work-product-score-assessed.rq); a BP with no assessed work product has no row. Mode "all" = q2-base-practice-score-v3.rq.
SELECT ?pj ?pas ?bp (COUNT(?ae) AS ?nWP) (AVG(?wpScore) AS ?bpScore)
WHERE {
  ?pas a iso:PreAssessment ; iso:hasBasePractice ?bp ; iso:hasAssessedEntity ?ae .
  ?ae iso:responsibleFor ?pj .
  { SELECT ?ae (AVG(?sc) AS ?wpScore)
    WHERE {
      ?ae iso:hasAssessmentResult ?ar .
      ?ar iso:hasPercentageAchievement ?pct .
      ?r a iso:Rating ; iso:hasMinPercentage ?mn ; iso:hasMaxPercentage ?mx ; iso:hasAssignedScore ?sc .
      FILTER (?pct >= ?mn && ?pct <= ?mx)
    } GROUP BY ?ae }
}
GROUP BY ?pj ?pas ?bp
ORDER BY ?pj ?bp
