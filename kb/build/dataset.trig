    iso:RP-PM.BP.09 a iso:RecommendedPractice,
            owl:NamedIndividual ;
        iso:addressesBasePractice iso:PM.BP.09 ;
        iso:hasPracticeDescription "Identify and document the risks which may affect the project." ;
        iso:hasPracticeName "Strengthen PM.BP9: Identify and document the risks which may affect the project" ;
