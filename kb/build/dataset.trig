    iso:RP-SI.BP.02 a iso:RecommendedPractice,
            owl:NamedIndividual ;
        iso:addressesBasePractice iso:SI.BP.02 ;
        iso:hasPracticeDescription "Verify and obtain approval of the Requirements Specification.Verify the correctness and testability of the Requirements Specification and its consistency with the Product Description. Additionally, review that requirements are complete, unambiguous, and not contradictory. The results found are documented in a Verification Results and corrections are made until the document is approved by AN. If significant changes were needed, initiate a Change Request." ;
        iso:hasPracticeName "Strengthen SI.BP2: Verify and obtain approval of the Requirements Specification.Verify the correctness and testability of the Requirements Specification and its consistency with the Product Description" ;
        rdfs:comment "Generated 1:1 from the Base Practice (scripts/generate_demo_data.py). Not an expert-validated QA guidance text." .

    iso:RP-SI.BP.08 a iso:RecommendedPractice,
            owl:NamedIndividual ;
        iso:addressesBasePractice iso:SI.BP.08 ;
        iso:hasPracticeDescription "Verify and obtain approval of the Test Cases and Test Procedures. Verify consistency among Requirements Specification, Software Design and Test Cases and Test Procedures. The results found are documented in a Verification Results and corrections are made until the document is approved." ;
        iso:hasPracticeName "Strengthen SI.BP8: Verify and obtain approval of the Test Cases and Test Procedures" ;
        rdfs:comment "Generated 1:1 from the Base Practice (scripts/generate_demo_data.py). Not an expert-validated QA guidance text." .

    iso:RP-SI.BP.17 a iso:RecommendedPractice,
            owl:NamedIndividual ;
        iso:addressesBasePractice iso:SI.BP.17 ;
        iso:hasPracticeDescription "Perform Software tests using Test Cases and Test Procedures for integration and document results in Test Report." ;
        iso:hasPracticeName "Strengthen SI.BP17: Perform Software tests using Test Cases and Test Procedures for integration and document results in Test Report" ;
        rdfs:comment "Generated 1:1 from the Base Practice (scripts/generate_demo_data.py). Not an expert-validated QA guidance text." .

