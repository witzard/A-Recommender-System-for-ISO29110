iso:hasInputWorkProduct a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasInputWorkProduct ;
            owl:someValuesFrom iso:InputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasOutputWorkProduct ;
            owl:someValuesFrom iso:OutputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasRole ;
            owl:someValuesFrom iso:Role ],
        [ a owl:Restriction ;
            owl:onProperty iso:isTaskOf ;
            owl:someValuesFrom iso:Activity ],
        iso:Task ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCurrentState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasFinalState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:InputWorkProduct,
        iso:WorkProduct ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isInputWorkProductOf .

iso:hasOutputWorkProduct a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasInputWorkProduct ;
            owl:someValuesFrom iso:InputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasOutputWorkProduct ;
            owl:someValuesFrom iso:OutputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasRole ;
            owl:someValuesFrom iso:Role ],
        [ a owl:Restriction ;
            owl:onProperty iso:isTaskOf ;
            owl:someValuesFrom iso:Activity ],
        iso:Task ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCurrentState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasFinalState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:OutputWorkProduct,
        iso:WorkProduct ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isOutputWorkProductOf .

iso:hasRole a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasInputWorkProduct ;
            owl:someValuesFrom iso:InputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasOutputWorkProduct ;
            owl:someValuesFrom iso:OutputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasRole ;
            owl:someValuesFrom iso:Role ],
        [ a owl:Restriction ;
            owl:onProperty iso:isTaskOf ;
            owl:someValuesFrom iso:Activity ],
        iso:Task ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:isRoleOf ;
            owl:someValuesFrom iso:Task ],
        iso:Role ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isRoleOf .

iso:isTaskOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

iso:Role a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:isRoleOf ;
            owl:someValuesFrom iso:Task ] .

iso:isCharacteristicsOf a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

