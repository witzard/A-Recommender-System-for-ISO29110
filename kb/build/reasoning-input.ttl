            owl:someValuesFrom iso:Consultant ],
        iso:PreAssessment ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:preAssessedBy .

iso:preAssessedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

