iso:addressesBasePractice a owl:ObjectProperty ;
    rdfs:label "addressesBasePractice" ;
    rdfs:comment "Links a QA (recommended) practice to the Base Practice it helps to achieve. In this prototype the mapping is 1:1 and generated from the Base Practices (data/qa-practices.ttl); it is NOT an expert-validated mapping." ;
    rdfs:domain iso:RecommendedPractice ;
    rdfs:range iso:BasePractice .

iso:assessesBasePractice a owl:ObjectProperty ;
    rdfs:label "assessesBasePractice" ;
    rdfs:comment "Links an assessment result to the ISO/IEC 29110 Base Practice whose achievement it rates." ;
    rdfs:domain iso:AssessmentResult ;
    rdfs:range iso:BasePractice .

iso:hasOutputWorkProductName a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCurrentState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasFinalState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:OutputWorkProduct,
        iso:WorkProduct ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

iso:hasWorkProductStateName a owl:DatatypeProperty ;
    rdfs:domain iso:WorkProductState ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

iso:isOutputWorkProductOf a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

