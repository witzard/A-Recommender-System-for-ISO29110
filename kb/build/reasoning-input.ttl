iso:hasAssessmentResult a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasAssessmentResult ;
            owl:someValuesFrom iso:AssessmentResult ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasEntity ;
            owl:someValuesFrom iso:WorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:isAssessedEntityOf ;
            owl:someValuesFrom iso:PreAssessment ],
        [ a owl:Restriction ;
            owl:onProperty iso:isResponsibilityOf ;
            owl:someValuesFrom iso:Project ],
        [ a owl:Restriction ;
            owl:onProperty iso:recommend ;
            owl:someValuesFrom iso:RecommendedPractice ],
        iso:AssessedEntity ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:hasDegreeAchievement ;
            owl:someValuesFrom iso:Rating ],
        [ a owl:Restriction ;
            owl:onProperty iso:isAssessmentResultOf ;
            owl:someValuesFrom iso:AssessedEntity ],
        iso:AssessmentResult ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isAssessmentResultOf .

iso:hasEntity a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasAssessmentResult ;
            owl:someValuesFrom iso:AssessmentResult ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasEntity ;
            owl:someValuesFrom iso:WorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:isAssessedEntityOf ;
            owl:someValuesFrom iso:PreAssessment ],
        [ a owl:Restriction ;
            owl:onProperty iso:isResponsibilityOf ;
            owl:someValuesFrom iso:Project ],
        [ a owl:Restriction ;
            owl:onProperty iso:recommend ;
            owl:someValuesFrom iso:RecommendedPractice ],
        iso:AssessedEntity ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isEntityOf .

iso:recommend a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasAssessmentResult ;
            owl:someValuesFrom iso:AssessmentResult ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasEntity ;
            owl:someValuesFrom iso:WorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:isAssessedEntityOf ;
            owl:someValuesFrom iso:PreAssessment ],
        [ a owl:Restriction ;
            owl:onProperty iso:isResponsibilityOf ;
            owl:someValuesFrom iso:Project ],
        [ a owl:Restriction ;
            owl:onProperty iso:recommend ;
            owl:someValuesFrom iso:RecommendedPractice ],
        iso:AssessedEntity ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:recommendedBy ;
            owl:someValuesFrom iso:AssessedEntity ],
        iso:RecommendedPractice ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:recommendedBy .

