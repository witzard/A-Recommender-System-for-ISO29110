    iso:hasWorkProductCharacteristicID "WPC.18" ;
    iso:hasWorkProductCharacteristicList """Test cases may include:
- Identifies the test case
- Test items (unit test cases, integration tests)
- Input specifications
- Output specifications
- Environmental needs
- Special procedural requirements
- Interface dependencies""" ;
    iso:hasWorkProductCharacteristicName "Test Cases and Test Procedures" .

