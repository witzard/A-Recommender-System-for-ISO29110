iso:Activity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:hasTask ;
            owl:someValuesFrom iso:Task ],
        [ a owl:Restriction ;
            owl:onProperty iso:isActivityOf ;
            owl:someValuesFrom iso:Process ] .

iso:Task a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:hasInputWorkProduct ;
            owl:someValuesFrom iso:InputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasOutputWorkProduct ;
            owl:someValuesFrom iso:OutputWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasRole ;
            owl:someValuesFrom iso:Role ],
        [ a owl:Restriction ;
            owl:onProperty iso:isTaskOf ;
            owl:someValuesFrom iso:Activity ] .

iso:hasCurrentState a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct ;
    rdfs:range iso:WorkProductState ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isCurrentStateOf .

iso:hasFinalState a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct ;
    rdfs:range iso:WorkProductState ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isFinalStateOf .

iso:hasApplicableState a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct ;
    rdfs:range iso:WorkProductState ;
    owl:inverseOf iso:isApplicableStateOf .

iso:hasCharacteristics a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:isCharacteristicsOf ;
            owl:someValuesFrom iso:WorkProduct ],
        iso:WorkProductCharacteristic ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isCharacteristicsOf .

iso:isWorkProductOf a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

iso:hasProcessOutcome a owl:ObjectProperty ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:isProcessOutcomeOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ] ],
        iso:ProcessOutcome ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isProcessOutcomeOf .

iso:ProcessOutcome a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:isProcessOutcomeOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ] ] .

iso:BasePractice a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isBasePracticeOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( iso:PreAssessment iso:Process ) ] ] .

iso:WorkProductCharacteristic a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:isCharacteristicsOf ;
            owl:someValuesFrom iso:WorkProduct ] .

iso:WorkProduct a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ] .

iso:OutputWorkProduct a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCurrentState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasFinalState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct .

iso:InputWorkProduct a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasApplicableState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCharacteristics ;
            owl:someValuesFrom iso:WorkProductCharacteristic ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasCurrentState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasFinalState ;
            owl:someValuesFrom iso:WorkProductState ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:isWorkProductOf ;
            owl:someValuesFrom iso:Process ],
        iso:WorkProduct .

iso:Process a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( iso:BasePractice iso:InputWorkProduct iso:OutputWorkProduct iso:Process ) ],
        [ a owl:Class ;
            owl:unionOf ( iso:PreAssessment iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasActivity ;
            owl:someValuesFrom iso:Activity ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasBasePractice ;
            owl:someValuesFrom iso:BasePractice ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessObjective ;
            owl:someValuesFrom iso:ProcessObjective ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcessOutcome ;
            owl:someValuesFrom iso:ProcessOutcome ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasWorkProduct ;
            owl:someValuesFrom iso:WorkProduct ] .

iso:WorkProductState a owl:Class .

[] a swrl:Imp ;
    rdfs:label "RatingPartiallyAchievedRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:ar ;
                    swrl:classPredicate iso:AssessmentResult ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 var:ar ;
                            swrl:argument2 var:score ;
                            swrl:propertyPredicate iso:hasPercentageAchievement ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first var:score ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 16 ;
                                                    rdf:rest () ] ] ;
                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments [ a rdf:List ;
                                                    rdf:first var:score ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 50 ;
                                                            rdf:rest () ] ] ;
                                            swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:ar ;
                    swrl:argument2 iso:Partially_achieved ;
                    swrl:propertyPredicate iso:hasDegreeAchievement ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    rdfs:label "RatingLargelyAchievedRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:ar ;
                    swrl:classPredicate iso:AssessmentResult ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 var:ar ;
                            swrl:argument2 var:score ;
                            swrl:propertyPredicate iso:hasPercentageAchievement ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first var:score ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 51 ;
                                                    rdf:rest () ] ] ;
                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments [ a rdf:List ;
                                                    rdf:first var:score ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 90 ;
                                                            rdf:rest () ] ] ;
                                            swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:ar ;
                    swrl:argument2 iso:Largely_achieved ;
                    swrl:propertyPredicate iso:hasDegreeAchievement ] ;
            rdf:rest () ] .

