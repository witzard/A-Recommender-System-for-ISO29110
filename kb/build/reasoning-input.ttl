[] a swrl:Imp ;
    rdfs:label "BasePracticeOutputWPRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:owp ;
                    swrl:classPredicate iso:OutputWorkProduct ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:owp ;
                            swrl:argument2 var:po ;
                            swrl:propertyPredicate iso:hasProcessOutcome ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 var:bp ;
                                    swrl:classPredicate iso:BasePractice ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:bp ;
                                            swrl:argument2 var:po ;
                                            swrl:propertyPredicate iso:hasProcessOutcome ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:owp ;
                    swrl:argument2 var:bp ;
                    swrl:propertyPredicate iso:isOutputWorkProductOf ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    rdfs:label "ApprovedRequirementSpecRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:owp ;
                    swrl:classPredicate iso:OutputWorkProduct ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 var:owp ;
                            swrl:argument2 var:name ;
                            swrl:propertyPredicate iso:hasOutputWorkProductName ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first var:name ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "Requirement" ;
                                                    rdf:rest () ] ] ;
                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#containsIgnoreCase> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:owp ;
                                            swrl:argument2 var:state ;
                                            swrl:propertyPredicate iso:hasFinalState ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 var:state ;
                                                    swrl:classPredicate iso:WorkProductState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 var:state ;
                                                            swrl:argument2 var:stateName ;
                                                            swrl:propertyPredicate iso:hasWorkProductStateName ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments [ a rdf:List ;
                                                                            rdf:first var:stateName ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "Approved" ;
                                                                                    rdf:rest () ] ] ;
                                                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#containsIgnoreCase> ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 var:owp ;
                                                                            swrl:argument2 var:ae ;
                                                                            swrl:propertyPredicate iso:isEntityOf ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:ae ;
                    swrl:argument2 var:owp ;
                    swrl:propertyPredicate iso:hasEntity ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    rdfs:label "ApprovedTestCaseRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:owp ;
                    swrl:classPredicate iso:OutputWorkProduct ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 var:owp ;
                            swrl:argument2 var:name ;
                            swrl:propertyPredicate iso:hasOutputWorkProductName ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments [ a rdf:List ;
                                            rdf:first var:name ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "Test case" ;
                                                    rdf:rest () ] ] ;
                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#containsIgnoreCase> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:owp ;
                                            swrl:argument2 var:state ;
                                            swrl:propertyPredicate iso:hasFinalState ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 var:state ;
                                                    swrl:classPredicate iso:WorkProductState ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 var:state ;
                                                            swrl:argument2 var:stateName ;
                                                            swrl:propertyPredicate iso:hasWorkProductStateName ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments [ a rdf:List ;
                                                                            rdf:first var:stateName ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "Approved" ;
                                                                                    rdf:rest () ] ] ;
                                                                    swrl:builtin <http://www.w3.org/2003/11/swrlb#containsIgnoreCase> ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 var:owp ;
                                                                            swrl:argument2 var:ae ;
                                                                            swrl:propertyPredicate iso:isEntityOf ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:ae ;
                    swrl:argument2 var:owp ;
                    swrl:propertyPredicate iso:hasEntity ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    rdfs:label "ImprovementRecommendationRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "REVISED 2026-11: recommend only the practice(s) addressing the Base Practice rated Not_achieved." ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 var:ae ;
                swrl:classPredicate iso:AssessedEntity ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ae ;
                swrl:argument2 var:ar ;
                swrl:propertyPredicate iso:hasAssessmentResult ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ar ;
                swrl:argument2 iso:Not_achieved ;
                swrl:propertyPredicate iso:hasDegreeAchievement ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ar ;
                swrl:argument2 var:bp ;
                swrl:propertyPredicate iso:assessesBasePractice ] [ a swrl:ClassAtom ;
                swrl:argument1 var:rp ;
                swrl:classPredicate iso:RecommendedPractice ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:rp ;
                swrl:argument2 var:bp ;
                swrl:propertyPredicate iso:addressesBasePractice ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ae ;
                swrl:argument2 var:rp ;
                swrl:propertyPredicate iso:recommend ] ) .

[] a swrl:Imp ;
    rdfs:label "PartialImprovementRecommendationRule" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "NEW 2026-11: recommend the practice(s) addressing a Base Practice rated Partially_achieved." ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 var:ae ;
                swrl:classPredicate iso:AssessedEntity ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ae ;
                swrl:argument2 var:ar ;
                swrl:propertyPredicate iso:hasAssessmentResult ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ar ;
                swrl:argument2 iso:Partially_achieved ;
                swrl:propertyPredicate iso:hasDegreeAchievement ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ar ;
                swrl:argument2 var:bp ;
                swrl:propertyPredicate iso:assessesBasePractice ] [ a swrl:ClassAtom ;
                swrl:argument1 var:rp ;
                swrl:classPredicate iso:RecommendedPractice ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:rp ;
                swrl:argument2 var:bp ;
                swrl:propertyPredicate iso:addressesBasePractice ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 var:ae ;
                swrl:argument2 var:rp ;
                swrl:propertyPredicate iso:recommend ] ) .

