iso:WPC.09.13 a [ a owl:Restriction ;
            owl:onProperty iso:isCharacteristicsOf ;
            owl:someValuesFrom iso:WorkProduct ],
        iso:WorkProductCharacteristic,
        owl:NamedIndividual ;
    iso:hasWorkProductCharacteristicDetail "Presents how the project processes and activities are executed to ensure the project's successful completion and the quality of the work products to be delivered according to the schedule." ;
    iso:hasWorkProductCharacteristicID "WPC.09" ;
    iso:hasWorkProductCharacteristicList """- Version control strategy
- Work product repository tools or mechanism identified
- Location and access mechanisms for the repository specified
- Version identification and control defined
- Description of the baselines selected for the project: e.g., requirements baseline (i.e., agreement), specification baseline, design baseline and product baseline
- Backup and recovery mechanisms defined
- Storage, handling and delivery (including archival and retrieval) mechanisms specified""" ;
    iso:hasWorkProductCharacteristicName "Project Plan" ;
    iso:hasWorkProductCharacteristicNote "Signed by customer and project manager" .

iso:WPC.09.14 a [ a owl:Restriction ;
            owl:onProperty iso:isCharacteristicsOf ;
