iso:hasAssessedEntity a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( iso:PreAssessment iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasAssessedEntity ;
            owl:someValuesFrom iso:AssessedEntity ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasBasePractice ;
            owl:someValuesFrom iso:BasePractice ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcess ;
            owl:someValuesFrom iso:Process ],
        [ a owl:Restriction ;
            owl:onProperty iso:preAssessedBy ;
            owl:someValuesFrom iso:Consultant ],
        iso:PreAssessment ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty iso:hasAssessmentResult ;
            owl:someValuesFrom iso:AssessmentResult ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasEntity ;
            owl:someValuesFrom iso:WorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty iso:isAssessedEntityOf ;
            owl:someValuesFrom iso:PreAssessment ],
        [ a owl:Restriction ;
            owl:onProperty iso:isResponsibilityOf ;
            owl:someValuesFrom iso:Project ],
        [ a owl:Restriction ;
            owl:onProperty iso:recommend ;
            owl:someValuesFrom iso:RecommendedPractice ],
        iso:AssessedEntity ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf iso:isAssessedEntityOf .

iso:recommendedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

