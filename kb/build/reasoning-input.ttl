@prefix iso: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix var: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

swrla:isRuleEnabled a owl:AnnotationProperty .

<http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2> a owl:Ontology .

iso:CS-DEMO a iso:Consultant,
        owl:NamedIndividual ;
    iso:hasAffiliation "Prototype demonstration" ;
    iso:hasConsultantName "Demo Assessor (synthetic)" ;
    iso:hasExperienceYear 5 ;
    iso:hasExpertType "Software process assessment" ;
    iso:preAssess iso:PAS-A1,
        iso:PAS-B1,
        iso:PAS-C1 .

iso:CS.01 a [ a owl:Restriction ;
            owl:onProperty iso:preAssess ;
            owl:someValuesFrom iso:PreAssessment ],
        iso:Consultant,
        owl:NamedIndividual ;
    iso:hasAffiliation "Affiliation_01" ;
    iso:hasConsultantName "Consultant_Name_01" ;
    iso:hasExperienceYear 0 ;
    iso:hasExpertType "Expert_type_01" .

iso:ENT-A a iso:Enterprise,
        owl:NamedIndividual ;
    iso:hasEnterpriseName "Company A" ;
    iso:hasProject iso:PJ-A1 ;
    rdfs:comment "Synthetic demo company. Mature practices: every assessed Base Practice is Largely or Completely achieved. Expected to receive no improvement recommendation." .

iso:ENT-B a iso:Enterprise,
        owl:NamedIndividual ;
    iso:hasEnterpriseName "Company B" ;
    iso:hasProject iso:PJ-B1 ;
    rdfs:comment "Synthetic demo company. Mixed maturity: most practices achieved, a few clear gaps, and one result with no recorded percentage." .

iso:ENT-C a iso:Enterprise,
        owl:NamedIndividual ;
    iso:hasEnterpriseName "Company C" ;
    iso:hasProject iso:PJ-C1 ;
    rdfs:comment "Synthetic demo company. Low maturity: several Base Practices are Not or Partially achieved." .

iso:ENT.01 a [ a owl:Restriction ;
            owl:onProperty iso:hasProject ;
            owl:someValuesFrom iso:Project ],
        iso:Enterprise,
        owl:NamedIndividual ;
    iso:hasEnterpriseName "Enterprise_Name_01" .

iso:Not_applicable a [ a owl:Restriction ;
            owl:onProperty iso:isDegreeAchievementOf ;
            owl:someValuesFrom iso:AssessmentResult ],
        iso:Rating,
        owl:NamedIndividual .

iso:PAS.01 a [ a owl:Restriction ;
            owl:onProperty iso:preAssessedBy ;
            owl:someValuesFrom iso:Consultant ],
        [ a owl:Class ;
            owl:unionOf ( iso:PreAssessment iso:Process ) ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasAssessedEntity ;
            owl:someValuesFrom iso:AssessedEntity ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasBasePractice ;
            owl:someValuesFrom iso:BasePractice ],
        [ a owl:Restriction ;
            owl:onProperty iso:hasProcess ;
            owl:someValuesFrom iso:Process ],
        iso:PreAssessment,
        owl:NamedIndividual ;
    iso:hasPreAssessedAchievementScore 0 ;
    iso:hasSummaryOfAchievementScore 0 .

iso:POBJ.01 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "The project plan for the execution of the project is developed according to the agreement and reviewed and accepted by the customer. The tasks and resources necessary to complete the work are sized and estimated." ;
    iso:hasProcessObjectiveID "PM.O1" .

iso:POBJ.02 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Progress of the project is monitored against the project plan and recorded in the progress status record. Corrections to remediate problems and deviations from the plan are taken when project targets are not achieved. Closure of the project is performed to get the customer acceptance documented in the acceptance record." ;
    iso:hasProcessObjectiveID "PM.O2" .

iso:POBJ.03 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription """The change requests are addressed through their reception and analysis. Changes to software requirements are evaluated for cost/ schedule and technical impact.
""" ;
    iso:hasProcessObjectiveID "PM.O3" .

iso:POBJ.04 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription """Review meetings with the work team and the customer are held. Agreements are registered and tracked.
""" ;
    iso:hasProcessObjectiveID "PM.O4" .

iso:POBJ.05 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Risks are identified as they develop and during the conduct of the project." ;
    iso:hasProcessObjectiveID "PM.O5" .

iso:POBJ.06 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "A software version control strategy is developed. Items of software product are identified/ defined and baselined. Modifications and releases of the items are controlled and made available to the customer and work team. The storage/ handling and delivery of the items are controlled." ;
    iso:hasProcessObjectiveID "PM.O6" .

iso:POBJ.07 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Software quality assurance is performed to provide assurance that work products and processes comply with the project plan and Requirement specification." ;
    iso:hasProcessObjectiveID "PM.O7" ;
    iso:hasProcessObjectiveNote "NOTE: Software quality assurance is implemented through the performance of the verification/ validation and review tasks performed in project management and software implementation processes." .

iso:POBJ.08 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Tasks of the activities are performed through the accomplishment of the current project plan." ;
    iso:hasProcessObjectiveID "SI.O1" .

iso:POBJ.09 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Software requirements are defined/ analysed for correctness and testability/ approved by the customer/ baselined and communicated." ;
    iso:hasProcessObjectiveID "SI.O2" .

iso:POBJ.10 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Software architectural and detailed design is developed and baselined. It describes the software components and internal and external interfaces of them. Consistency and traceability to software requirements are established." ;
    iso:hasProcessObjectiveID "SI.O3" ;
    iso:hasProcessObjectiveNote "NOTE: Software architecture and detailed design can be performed separately according to the project schedule." .

iso:POBJ.11 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription """Software components defined by the design are produced. Unit tests are defined and performed to verify the consistency with requirements and the design. Traceability to the requirements and design are established.
""" ;
    iso:hasProcessObjectiveID "SI.O4" .

iso:POBJ.12 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription """Software is produced performing integration of software components and verified using test cases and test procedures. Results are recorded in the test report. Defects are corrected and consistency and traceability to software design are established.
""" ;
    iso:hasProcessObjectiveID "SI.O5" .

iso:POBJ.13 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "A software product/ that meets the Requirement specification as agreed to with the customer/ which includes user/ operation and maintenance documentations is integrated/ baselined and stored at the project repository. Needs for changes to the software product are detected and related change requests are initiated." ;
    iso:hasProcessObjectiveID "SI.O6" .

iso:POBJ.14 a [ a owl:Restriction ;
            owl:onProperty iso:isProcessObjectiveOf ;
            owl:someValuesFrom iso:Process ],
        iso:ProcessObjective,
        owl:NamedIndividual ;
    iso:hasProcessObjectiveDescription "Verification and validation tasks of all required work products are performed using the defined criteria to achieve consistency among output work products and input work products in each activity. Defects are identified and corrected; records are stored in the verification/validation records." ;
    iso:hasProcessObjectiveID "SI.O7" ;
    iso:hasProcessObjectiveNote "NOTE: It's not the intention that all verification activities and work products are made available to the customer. Verifications should be performed by individuals that have organisational freedom/ authority/ to permit objective evaluation/ and to initiate/ effect/ resolve and verify problem resolution." .

