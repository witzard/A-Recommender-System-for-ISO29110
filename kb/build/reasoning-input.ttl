iso:RP-SI.BP.01 a iso:RecommendedPractice,
        owl:NamedIndividual ;
    iso:addressesBasePractice iso:SI.BP.01 ;
    iso:hasPracticeDescription "Document or update the Requirements Specification. Identify and consult information sources (Customer, users, previous systems, documents, etc.) in order to get new requirements. Analyse the identified requirements to determinate the Scope and feasibility. Generate or update the Requirements Specification" ;
