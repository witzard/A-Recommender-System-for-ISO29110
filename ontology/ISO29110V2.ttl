###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.01
ISO29110V2:POBJ.01 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "The project plan for the execution of the project is developed according to the agreement and reviewed and accepted by the customer. The tasks and resources necessary to complete the work are sized and estimated." ;
                   ISO29110V2:hasProcessObjectiveID "PM.O1" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.02
ISO29110V2:POBJ.02 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Progress of the project is monitored against the project plan and recorded in the progress status record. Corrections to remediate problems and deviations from the plan are taken when project targets are not achieved. Closure of the project is performed to get the customer acceptance documented in the acceptance record." ;
                   ISO29110V2:hasProcessObjectiveID "PM.O2" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.03
ISO29110V2:POBJ.03 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription """The change requests are addressed through their reception and analysis. Changes to software requirements are evaluated for cost/ schedule and technical impact.
""" ;
                   ISO29110V2:hasProcessObjectiveID "PM.O3" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.04
ISO29110V2:POBJ.04 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription """Review meetings with the work team and the customer are held. Agreements are registered and tracked.
""" ;
                   ISO29110V2:hasProcessObjectiveID "PM.O4" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.05
ISO29110V2:POBJ.05 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Risks are identified as they develop and during the conduct of the project." ;
                   ISO29110V2:hasProcessObjectiveID "PM.O5" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.06
ISO29110V2:POBJ.06 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "A software version control strategy is developed. Items of software product are identified/ defined and baselined. Modifications and releases of the items are controlled and made available to the customer and work team. The storage/ handling and delivery of the items are controlled." ;
                   ISO29110V2:hasProcessObjectiveID "PM.O6" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.07
ISO29110V2:POBJ.07 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Software quality assurance is performed to provide assurance that work products and processes comply with the project plan and Requirement specification." ;
                   ISO29110V2:hasProcessObjectiveID "PM.O7" ;
                   ISO29110V2:hasProcessObjectiveNote "NOTE: Software quality assurance is implemented through the performance of the verification/ validation and review tasks performed in project management and software implementation processes." .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.08
ISO29110V2:POBJ.08 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Tasks of the activities are performed through the accomplishment of the current project plan." ;
                   ISO29110V2:hasProcessObjectiveID "SI.O1" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.09
ISO29110V2:POBJ.09 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Software requirements are defined/ analysed for correctness and testability/ approved by the customer/ baselined and communicated." ;
                   ISO29110V2:hasProcessObjectiveID "SI.O2" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.10
ISO29110V2:POBJ.10 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Software architectural and detailed design is developed and baselined. It describes the software components and internal and external interfaces of them. Consistency and traceability to software requirements are established." ;
                   ISO29110V2:hasProcessObjectiveID "SI.O3" ;
                   ISO29110V2:hasProcessObjectiveNote "NOTE: Software architecture and detailed design can be performed separately according to the project schedule." .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.11
ISO29110V2:POBJ.11 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription """Software components defined by the design are produced. Unit tests are defined and performed to verify the consistency with requirements and the design. Traceability to the requirements and design are established.
""" ;
                   ISO29110V2:hasProcessObjectiveID "SI.O4" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.12
ISO29110V2:POBJ.12 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription """Software is produced performing integration of software components and verified using test cases and test procedures. Results are recorded in the test report. Defects are corrected and consistency and traceability to software design are established.
""" ;
                   ISO29110V2:hasProcessObjectiveID "SI.O5" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.13
ISO29110V2:POBJ.13 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "A software product/ that meets the Requirement specification as agreed to with the customer/ which includes user/ operation and maintenance documentations is integrated/ baselined and stored at the project repository. Needs for changes to the software product are detected and related change requests are initiated." ;
                   ISO29110V2:hasProcessObjectiveID "SI.O6" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#POBJ.14
ISO29110V2:POBJ.14 rdf:type owl:NamedIndividual ,
                            ISO29110V2:ProcessObjective ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                              owl:someValuesFrom ISO29110V2:Process
                            ] ;
                   ISO29110V2:hasProcessObjectiveDescription "Verification and validation tasks of all required work products are performed using the defined criteria to achieve consistency among output work products and input work products in each activity. Defects are identified and corrected; records are stored in the verification/validation records." ;
                   ISO29110V2:hasProcessObjectiveID "SI.O7" ;
                   ISO29110V2:hasProcessObjectiveNote "NOTE: It's not the intention that all verification activities and work products are made available to the customer. Verifications should be performed by individuals that have organisational freedom/ authority/ to permit objective evaluation/ and to initiate/ effect/ resolve and verify problem resolution." .


