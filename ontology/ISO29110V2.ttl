                       ISO29110V2:hasInputWorkProduct ISO29110V2:SI.IWP.02.02.WP02 ,
                                                      ISO29110V2:SI.IWP.02.02.WP10 ;
                       ISO29110V2:hasOutputWorkProduct ISO29110V2:SI.OWP.02.02.WP13 ;
                       ISO29110V2:hasRole ISO29110V2:SI.ROLE.05 ,
                                          ISO29110V2:SI.ROLE.06 ;
                       ISO29110V2:isTaskOf ISO29110V2:SI.ACT.02 ;
                       ISO29110V2:hasTaskDescription """Document the software Requirement specification:
- Analyse the requirements defined in the agreement to determinate the scope and feasibility.
- Identify and consult information sources (e.g./ customer/ users/ previous software products/ documents) to get new or missing requirements.""" ;
                       ISO29110V2:hasTaskID "SI.2.2" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#SI.PT.02.03
ISO29110V2:SI.PT.02.03 rdf:type owl:NamedIndividual ,
                                ISO29110V2:Task ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasInputWorkProduct ;
                                  owl:someValuesFrom ISO29110V2:InputWorkProduct
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasOutputWorkProduct ;
                                  owl:someValuesFrom ISO29110V2:OutputWorkProduct
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasRole ;
                                  owl:someValuesFrom ISO29110V2:Role
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:isTaskOf ;
                                  owl:someValuesFrom ISO29110V2:Activity
                                ] ;
                       ISO29110V2:hasInputWorkProduct ISO29110V2:SI.IWP.02.03.WP10 ,
                                                      ISO29110V2:SI.IWP.02.03.WP13 ;
                       ISO29110V2:hasOutputWorkProduct ISO29110V2:SI.OWP.02.03.WP03 ,
                                                       ISO29110V2:SI.OWP.02.03.WP13 ,
                                                       ISO29110V2:SI.OWP.02.03.WP23 ;
                       ISO29110V2:hasRole ISO29110V2:SI.ROLE.06 ,
                                          ISO29110V2:SI.ROLE.10 ;
                       ISO29110V2:isTaskOf ISO29110V2:SI.ACT.02 ;
                       ISO29110V2:hasTaskDescription """Verify and obtain approval of the software Requirement specification from the AN:
- Make corrections until the document is approved by AN.
- Verify the correctness and testability of the software Requirement specification and its consistency with the product description.
- Review to check that requirements are complete/ unambiguous and not contradictory. 
- Conditional task: Initiate a change request if significant changes (those affecting project delivery schedule/ project costs/ etc.) were needed.""" ;
                       ISO29110V2:hasTaskID "SI.2.3" ;
                       ISO29110V2:hasTaskNote "NOTE 1: The results of the verification are documented in the verification record." ,
                                              "NOTE 2: ISO/IEC 20246 defines different types of work product reviews." .


