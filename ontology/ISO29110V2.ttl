ISO29110V2:SI.PT.02.02 rdf:type owl:NamedIndividual ,
                                ISO29110V2:Task ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasInputWorkProduct ;
