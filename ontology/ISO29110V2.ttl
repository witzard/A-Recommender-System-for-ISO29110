@prefix : <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ISO29110V2: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#> .
@base <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2/> .

<http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
ns2:isRuleEnabled rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasActivity
ISO29110V2:hasActivity rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       owl:inverseOf ISO29110V2:isActivityOf ;
                       rdfs:domain ISO29110V2:Process ,
                                   [ rdf:type owl:Class ;
                                     owl:unionOf ( ISO29110V2:BasePractice
                                                   ISO29110V2:InputWorkProduct
                                                   ISO29110V2:OutputWorkProduct
                                                   ISO29110V2:Process
                                                 )
                                   ] ,
                                   [ rdf:type owl:Class ;
                                     owl:unionOf ( ISO29110V2:PreAssessment
                                                   ISO29110V2:Process
                                                 )
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasActivity ;
                                     owl:someValuesFrom ISO29110V2:Activity
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasBasePractice ;
                                     owl:someValuesFrom ISO29110V2:BasePractice
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasProcessObjective ;
                                     owl:someValuesFrom ISO29110V2:ProcessObjective
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasProcessOutcome ;
                                     owl:someValuesFrom ISO29110V2:ProcessOutcome
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasWorkProduct ;
                                     owl:someValuesFrom ISO29110V2:WorkProduct
                                   ] ;
                       rdfs:range ISO29110V2:Activity ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ISO29110V2:hasTask ;
                                    owl:someValuesFrom ISO29110V2:Task
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ISO29110V2:isActivityOf ;
                                    owl:someValuesFrom ISO29110V2:Process
                                  ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasApplicableState
ISO29110V2:hasApplicableState rdf:type owl:ObjectProperty ;
                              owl:inverseOf ISO29110V2:isApplicableStateOf ;
                              rdfs:domain ISO29110V2:WorkProduct ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasApplicableState ;
                                            owl:someValuesFrom ISO29110V2:WorkProductState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasCharacteristics ;
                                            owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isWorkProductOf ;
                                            owl:someValuesFrom ISO29110V2:Process
                                          ] ;
                              rdfs:range ISO29110V2:WorkProductState .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasAssessedEntity
ISO29110V2:hasAssessedEntity rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             owl:inverseOf ISO29110V2:isAssessedEntityOf ;
                             rdfs:domain ISO29110V2:PreAssessment ,
                                         [ rdf:type owl:Class ;
                                           owl:unionOf ( ISO29110V2:PreAssessment
                                                         ISO29110V2:Process
                                                       )
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty ISO29110V2:hasAssessedEntity ;
                                           owl:someValuesFrom ISO29110V2:AssessedEntity
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty ISO29110V2:hasBasePractice ;
                                           owl:someValuesFrom ISO29110V2:BasePractice
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty ISO29110V2:hasProcess ;
                                           owl:someValuesFrom ISO29110V2:Process
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty ISO29110V2:preAssessedBy ;
                                           owl:someValuesFrom ISO29110V2:Consultant
                                         ] ;
                             rdfs:range ISO29110V2:AssessedEntity ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:hasAssessmentResult ;
                                          owl:someValuesFrom ISO29110V2:AssessmentResult
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:hasEntity ;
                                          owl:someValuesFrom ISO29110V2:WorkProduct
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:isAssessedEntityOf ;
                                          owl:someValuesFrom ISO29110V2:PreAssessment
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:isResponsibilityOf ;
                                          owl:someValuesFrom ISO29110V2:Project
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:recommend ;
                                          owl:someValuesFrom ISO29110V2:RecommendedPractice
                                        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasAssessmentResult
ISO29110V2:hasAssessmentResult rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               owl:inverseOf ISO29110V2:isAssessmentResultOf ;
                               rdfs:domain ISO29110V2:AssessedEntity ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasAssessmentResult ;
                                             owl:someValuesFrom ISO29110V2:AssessmentResult
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasEntity ;
                                             owl:someValuesFrom ISO29110V2:WorkProduct
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:isAssessedEntityOf ;
                                             owl:someValuesFrom ISO29110V2:PreAssessment
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:isResponsibilityOf ;
                                             owl:someValuesFrom ISO29110V2:Project
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:recommend ;
                                             owl:someValuesFrom ISO29110V2:RecommendedPractice
                                           ] ;
                               rdfs:range ISO29110V2:AssessmentResult ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasDegreeAchievement ;
                                            owl:someValuesFrom ISO29110V2:Rating
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isAssessmentResultOf ;
                                            owl:someValuesFrom ISO29110V2:AssessedEntity
                                          ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasBasePractice
ISO29110V2:hasBasePractice rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           owl:inverseOf ISO29110V2:isBasePracticeOf ;
                           rdfs:range ISO29110V2:BasePractice ,
                                      [ rdf:type owl:Class ;
                                        owl:unionOf ( ISO29110V2:BasePractice
                                                      ISO29110V2:InputWorkProduct
                                                      ISO29110V2:OutputWorkProduct
                                                      ISO29110V2:Process
                                                    )
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ISO29110V2:hasProcessOutcome ;
                                        owl:someValuesFrom ISO29110V2:ProcessOutcome
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ISO29110V2:isBasePracticeOf ;
                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( ISO29110V2:PreAssessment
                                                                           ISO29110V2:Process
                                                                         )
                                                           ]
                                      ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasCharacteristics
ISO29110V2:hasCharacteristics rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf owl:topObjectProperty ;
                              owl:inverseOf ISO29110V2:isCharacteristicsOf ;
                              rdfs:domain ISO29110V2:WorkProduct ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasApplicableState ;
                                            owl:someValuesFrom ISO29110V2:WorkProductState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasCharacteristics ;
                                            owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isWorkProductOf ;
                                            owl:someValuesFrom ISO29110V2:Process
                                          ] ;
                              rdfs:range ISO29110V2:WorkProductCharacteristic ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty ISO29110V2:isCharacteristicsOf ;
                                           owl:someValuesFrom ISO29110V2:WorkProduct
                                         ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasCurrentState
ISO29110V2:hasCurrentState rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           owl:inverseOf ISO29110V2:isCurrentStateOf ;
                           rdfs:domain ISO29110V2:WorkProduct ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:hasApplicableState ;
                                         owl:someValuesFrom ISO29110V2:WorkProductState
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:hasCharacteristics ;
                                         owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:isWorkProductOf ;
                                         owl:someValuesFrom ISO29110V2:Process
                                       ] ;
                           rdfs:range ISO29110V2:WorkProductState .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasDegreeAchievement
ISO29110V2:hasDegreeAchievement rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf owl:topObjectProperty ;
                                owl:inverseOf ISO29110V2:isDegreeAchievementOf ;
                                rdfs:domain ISO29110V2:AssessmentResult ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:hasDegreeAchievement ;
                                              owl:someValuesFrom ISO29110V2:Rating
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:isAssessmentResultOf ;
                                              owl:someValuesFrom ISO29110V2:AssessedEntity
                                            ] ;
                                rdfs:range ISO29110V2:Rating ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:isDegreeAchievementOf ;
                                             owl:someValuesFrom ISO29110V2:AssessmentResult
                                           ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasEntity
ISO29110V2:hasEntity rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     owl:inverseOf ISO29110V2:isEntityOf ;
                     rdfs:domain ISO29110V2:AssessedEntity ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasAssessmentResult ;
                                   owl:someValuesFrom ISO29110V2:AssessmentResult
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasEntity ;
                                   owl:someValuesFrom ISO29110V2:WorkProduct
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:isAssessedEntityOf ;
                                   owl:someValuesFrom ISO29110V2:PreAssessment
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:isResponsibilityOf ;
                                   owl:someValuesFrom ISO29110V2:Project
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:recommend ;
                                   owl:someValuesFrom ISO29110V2:RecommendedPractice
                                 ] ;
                     rdfs:range ISO29110V2:WorkProduct ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasApplicableState ;
                                  owl:someValuesFrom ISO29110V2:WorkProductState
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasCharacteristics ;
                                  owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:isWorkProductOf ;
                                  owl:someValuesFrom ISO29110V2:Process
                                ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasFinalState
ISO29110V2:hasFinalState rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         owl:inverseOf ISO29110V2:isFinalStateOf ;
                         rdfs:domain ISO29110V2:WorkProduct ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ISO29110V2:hasApplicableState ;
                                       owl:someValuesFrom ISO29110V2:WorkProductState
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ISO29110V2:hasCharacteristics ;
                                       owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ISO29110V2:isWorkProductOf ;
                                       owl:someValuesFrom ISO29110V2:Process
                                     ] ;
                         rdfs:range ISO29110V2:WorkProductState .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasInputWorkProduct
ISO29110V2:hasInputWorkProduct rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               owl:inverseOf ISO29110V2:isInputWorkProductOf ;
                               rdfs:domain ISO29110V2:Task ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasInputWorkProduct ;
                                             owl:someValuesFrom ISO29110V2:InputWorkProduct
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasOutputWorkProduct ;
                                             owl:someValuesFrom ISO29110V2:OutputWorkProduct
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasRole ;
                                             owl:someValuesFrom ISO29110V2:Role
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:isTaskOf ;
                                             owl:someValuesFrom ISO29110V2:Activity
                                           ] ;
                               rdfs:range ISO29110V2:InputWorkProduct ,
                                          ISO29110V2:WorkProduct ,
                                          [ rdf:type owl:Class ;
                                            owl:unionOf ( ISO29110V2:BasePractice
                                                          ISO29110V2:InputWorkProduct
                                                          ISO29110V2:OutputWorkProduct
                                                          ISO29110V2:Process
                                                        )
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasApplicableState ;
                                            owl:someValuesFrom ISO29110V2:WorkProductState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasCharacteristics ;
                                            owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasCurrentState ;
                                            owl:someValuesFrom ISO29110V2:WorkProductState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasFinalState ;
                                            owl:someValuesFrom ISO29110V2:WorkProductState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasProcessOutcome ;
                                            owl:someValuesFrom ISO29110V2:ProcessOutcome
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isWorkProductOf ;
                                            owl:someValuesFrom ISO29110V2:Process
                                          ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasOutputWorkProduct
ISO29110V2:hasOutputWorkProduct rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf owl:topObjectProperty ;
                                owl:inverseOf ISO29110V2:isOutputWorkProductOf ;
                                rdfs:domain ISO29110V2:Task ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:hasInputWorkProduct ;
                                              owl:someValuesFrom ISO29110V2:InputWorkProduct
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:hasOutputWorkProduct ;
                                              owl:someValuesFrom ISO29110V2:OutputWorkProduct
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:hasRole ;
                                              owl:someValuesFrom ISO29110V2:Role
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:isTaskOf ;
                                              owl:someValuesFrom ISO29110V2:Activity
                                            ] ;
                                rdfs:range ISO29110V2:OutputWorkProduct ,
                                           ISO29110V2:WorkProduct ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( ISO29110V2:BasePractice
                                                           ISO29110V2:InputWorkProduct
                                                           ISO29110V2:OutputWorkProduct
                                                           ISO29110V2:Process
                                                         )
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasApplicableState ;
                                             owl:someValuesFrom ISO29110V2:WorkProductState
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasCharacteristics ;
                                             owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasCurrentState ;
                                             owl:someValuesFrom ISO29110V2:WorkProductState
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasFinalState ;
                                             owl:someValuesFrom ISO29110V2:WorkProductState
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasProcessOutcome ;
                                             owl:someValuesFrom ISO29110V2:ProcessOutcome
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:isWorkProductOf ;
                                             owl:someValuesFrom ISO29110V2:Process
                                           ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasProcess
ISO29110V2:hasProcess rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      owl:inverseOf ISO29110V2:isProcessOf ;
                      rdfs:range ISO29110V2:Process ,
                                 [ rdf:type owl:Class ;
                                   owl:unionOf ( ISO29110V2:BasePractice
                                                 ISO29110V2:InputWorkProduct
                                                 ISO29110V2:OutputWorkProduct
                                                 ISO29110V2:Process
                                               )
                                 ] ,
                                 [ rdf:type owl:Class ;
                                   owl:unionOf ( ISO29110V2:PreAssessment
                                                 ISO29110V2:Process
                                               )
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasActivity ;
                                   owl:someValuesFrom ISO29110V2:Activity
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasBasePractice ;
                                   owl:someValuesFrom ISO29110V2:BasePractice
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasProcessObjective ;
                                   owl:someValuesFrom ISO29110V2:ProcessObjective
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasProcessOutcome ;
                                   owl:someValuesFrom ISO29110V2:ProcessOutcome
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasWorkProduct ;
                                   owl:someValuesFrom ISO29110V2:WorkProduct
                                 ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasProcessObjective
ISO29110V2:hasProcessObjective rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               owl:inverseOf ISO29110V2:isProcessObjectiveOf ;
                               rdfs:domain ISO29110V2:Process ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( ISO29110V2:BasePractice
                                                           ISO29110V2:InputWorkProduct
                                                           ISO29110V2:OutputWorkProduct
                                                           ISO29110V2:Process
                                                         )
                                           ] ,
                                           [ rdf:type owl:Class ;
                                             owl:unionOf ( ISO29110V2:PreAssessment
                                                           ISO29110V2:Process
                                                         )
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasActivity ;
                                             owl:someValuesFrom ISO29110V2:Activity
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasBasePractice ;
                                             owl:someValuesFrom ISO29110V2:BasePractice
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasProcessObjective ;
                                             owl:someValuesFrom ISO29110V2:ProcessObjective
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasProcessOutcome ;
                                             owl:someValuesFrom ISO29110V2:ProcessOutcome
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ISO29110V2:hasWorkProduct ;
                                             owl:someValuesFrom ISO29110V2:WorkProduct
                                           ] ;
                               rdfs:range ISO29110V2:ProcessObjective ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                                            owl:someValuesFrom ISO29110V2:Process
                                          ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasProcessOutcome
ISO29110V2:hasProcessOutcome rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             owl:inverseOf ISO29110V2:isProcessOutcomeOf ;
                             rdfs:range ISO29110V2:ProcessOutcome ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ISO29110V2:isProcessOutcomeOf ;
                                          owl:someValuesFrom [ rdf:type owl:Class ;
                                                               owl:unionOf ( ISO29110V2:BasePractice
                                                                             ISO29110V2:InputWorkProduct
                                                                             ISO29110V2:OutputWorkProduct
                                                                             ISO29110V2:Process
                                                                           )
                                                             ]
                                        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasProject
ISO29110V2:hasProject rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      owl:inverseOf ISO29110V2:isProjectOf ;
                      rdfs:domain ISO29110V2:Enterprise ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ISO29110V2:hasProject ;
                                    owl:someValuesFrom ISO29110V2:Project
                                  ] ;
                      rdfs:range ISO29110V2:Project ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:hasProcess ;
                                   owl:someValuesFrom ISO29110V2:Process
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:isProjectOf ;
                                   owl:someValuesFrom ISO29110V2:Enterprise
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ISO29110V2:responsibleFor ;
                                   owl:someValuesFrom ISO29110V2:AssessedEntity
                                 ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasRole
