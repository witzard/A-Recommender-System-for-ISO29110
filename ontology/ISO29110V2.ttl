#################################################################
#    Rules
#################################################################

:ae rdf:type ns1:Variable .

:ar rdf:type ns1:Variable .

:rp rdf:type ns1:Variable .

:score rdf:type ns1:Variable .

:owp rdf:type ns1:Variable .

:po rdf:type ns1:Variable .

:bp rdf:type ns1:Variable .

:name rdf:type ns1:Variable .

:state rdf:type ns1:Variable .

:stateName rdf:type ns1:Variable .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "ImprovementRecommendationRule" ;
   rdf:type ns1:Imp ;
   ns1:body [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:ClassAtom ;
                          ns1:classPredicate ISO29110V2:AssessedEntity ;
                          ns1:argument1 :ae
                        ] ;
              rdf:rest [ rdf:type ns1:AtomList ;
                         rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                                     ns1:propertyPredicate ISO29110V2:hasAssessmentResult ;
                                     ns1:argument1 :ae ;
                                     ns1:argument2 :ar
                                   ] ;
                         rdf:rest [ rdf:type ns1:AtomList ;
                                    rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                                                ns1:propertyPredicate ISO29110V2:hasDegreeAchievement ;
                                                ns1:argument1 :ar ;
                                                ns1:argument2 ISO29110V2:Not_achieved
                                              ] ;
                                    rdf:rest [ rdf:type ns1:AtomList ;
                                               rdf:first [ rdf:type ns1:ClassAtom ;
                                                           ns1:classPredicate ISO29110V2:RecommendedPractice ;
                                                           ns1:argument1 :rp
                                                         ] ;
                                               rdf:rest rdf:nil
                                             ]
                                  ]
                       ]
            ] ;
   ns1:head [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                          ns1:propertyPredicate ISO29110V2:recommend ;
                          ns1:argument1 :ae ;
                          ns1:argument2 :rp
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "RatingPartiallyAchievedRule" ;
   rdf:type ns1:Imp ;
   ns1:body [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:ClassAtom ;
                          ns1:classPredicate ISO29110V2:AssessmentResult ;
                          ns1:argument1 :ar
                        ] ;
              rdf:rest [ rdf:type ns1:AtomList ;
                         rdf:first [ rdf:type ns1:DatavaluedPropertyAtom ;
                                     ns1:propertyPredicate ISO29110V2:hasPercentageAchievement ;
                                     ns1:argument1 :ar ;
                                     ns1:argument2 :score
                                   ] ;
                         rdf:rest [ rdf:type ns1:AtomList ;
                                    rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                ns1:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ;
                                                ns1:arguments [ rdf:type rdf:List ;
                                                                rdf:first :score ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first 16 ;
                                                                           rdf:rest rdf:nil
                                                                         ]
                                                              ]
                                              ] ;
                                    rdf:rest [ rdf:type ns1:AtomList ;
                                               rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                           ns1:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ;
                                                           ns1:arguments [ rdf:type rdf:List ;
                                                                           rdf:first :score ;
                                                                           rdf:rest [ rdf:type rdf:List ;
                                                                                      rdf:first 50 ;
                                                                                      rdf:rest rdf:nil
                                                                                    ]
                                                                         ]
                                                         ] ;
                                               rdf:rest rdf:nil
                                             ]
                                  ]
                       ]
            ] ;
   ns1:head [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                          ns1:propertyPredicate ISO29110V2:hasDegreeAchievement ;
                          ns1:argument1 :ar ;
                          ns1:argument2 ISO29110V2:Partially_achieved
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "RatingLargelyAchievedRule" ;
   rdf:type ns1:Imp ;
   ns1:body [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:ClassAtom ;
                          ns1:classPredicate ISO29110V2:AssessmentResult ;
                          ns1:argument1 :ar
                        ] ;
              rdf:rest [ rdf:type ns1:AtomList ;
                         rdf:first [ rdf:type ns1:DatavaluedPropertyAtom ;
                                     ns1:propertyPredicate ISO29110V2:hasPercentageAchievement ;
                                     ns1:argument1 :ar ;
                                     ns1:argument2 :score
                                   ] ;
                         rdf:rest [ rdf:type ns1:AtomList ;
                                    rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                ns1:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ;
                                                ns1:arguments [ rdf:type rdf:List ;
                                                                rdf:first :score ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first 51 ;
                                                                           rdf:rest rdf:nil
                                                                         ]
                                                              ]
                                              ] ;
                                    rdf:rest [ rdf:type ns1:AtomList ;
                                               rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                           ns1:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ;
                                                           ns1:arguments [ rdf:type rdf:List ;
                                                                           rdf:first :score ;
                                                                           rdf:rest [ rdf:type rdf:List ;
                                                                                      rdf:first 90 ;
                                                                                      rdf:rest rdf:nil
                                                                                    ]
                                                                         ]
                                                         ] ;
                                               rdf:rest rdf:nil
                                             ]
                                  ]
                       ]
            ] ;
   ns1:head [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                          ns1:propertyPredicate ISO29110V2:hasDegreeAchievement ;
                          ns1:argument1 :ar ;
                          ns1:argument2 ISO29110V2:Largely_achieved
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "RatingCompletelyAchievedRule" ;
   rdf:type ns1:Imp ;
   ns1:body [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:ClassAtom ;
                          ns1:classPredicate ISO29110V2:AssessmentResult ;
                          ns1:argument1 :ar
                        ] ;
              rdf:rest [ rdf:type ns1:AtomList ;
                         rdf:first [ rdf:type ns1:DatavaluedPropertyAtom ;
                                     ns1:propertyPredicate ISO29110V2:hasPercentageAchievement ;
                                     ns1:argument1 :ar ;
                                     ns1:argument2 :score
                                   ] ;
                         rdf:rest [ rdf:type ns1:AtomList ;
                                    rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                ns1:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual> ;
                                                ns1:arguments [ rdf:type rdf:List ;
                                                                rdf:first :score ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first 91 ;
                                                                           rdf:rest rdf:nil
                                                                         ]
                                                              ]
                                              ] ;
                                    rdf:rest rdf:nil
                                  ]
                       ]
            ] ;
   ns1:head [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:IndividualPropertyAtom ;
                          ns1:propertyPredicate ISO29110V2:hasDegreeAchievement ;
                          ns1:argument1 :ar ;
                          ns1:argument2 ISO29110V2:Completely_achieved
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "RatingNotAchievedRule" ;
   rdf:type ns1:Imp ;
   ns1:body [ rdf:type ns1:AtomList ;
              rdf:first [ rdf:type ns1:ClassAtom ;
                          ns1:classPredicate ISO29110V2:AssessmentResult ;
                          ns1:argument1 :ar
                        ] ;
              rdf:rest [ rdf:type ns1:AtomList ;
                         rdf:first [ rdf:type ns1:DatavaluedPropertyAtom ;
                                     ns1:propertyPredicate ISO29110V2:hasPercentageAchievement ;
                                     ns1:argument1 :ar ;
                                     ns1:argument2 :score
                                   ] ;
                         rdf:rest [ rdf:type ns1:AtomList ;
                                    rdf:first [ rdf:type ns1:BuiltinAtom ;
                                                ns1:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ;
                                                ns1:arguments [ rdf:type rdf:List ;
                                                                rdf:first :score ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first 15 ;
                                                                           rdf:rest rdf:nil
                                                                         ]
                                                              ]
                                              ] ;
                                    rdf:rest rdf:nil
                                  ]
                       ]
            ] ;
   ns1:head [ rdf:type ns1:AtomList ;
