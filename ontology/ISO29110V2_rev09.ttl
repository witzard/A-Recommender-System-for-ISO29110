@prefix : <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ISO29110V2: <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#> .
@base <http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2/> .

<http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
ns2:isRuleEnabled rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasActivity
ISO29110V2:hasActivity rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isActivityOf ;
    rdfs:domain ISO29110V2:Process ;
    rdfs:range ISO29110V2:Activity .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasApplicableState
ISO29110V2:hasApplicableState rdf:type owl:ObjectProperty ;
    owl:inverseOf ISO29110V2:isApplicableStateOf ;
    rdfs:domain ISO29110V2:WorkProduct ;
    rdfs:range ISO29110V2:WorkProductState .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasAssessedCharacteristic
ISO29110V2:hasAssessedCharacteristic rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdf:type owl:FunctionalProperty ;
                                     rdfs:domain ISO29110V2:AssessmentResult ;
                                     rdfs:range ISO29110V2:WorkProductCharacteristic .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasAssessedEntity
ISO29110V2:hasAssessedEntity rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isAssessedEntityOf ;
    rdfs:domain ISO29110V2:PreAssessment ;
    rdfs:range ISO29110V2:AssessedEntity .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasAssessmentResult
ISO29110V2:hasAssessmentResult rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isAssessmentResultOf ;
    rdfs:domain ISO29110V2:AssessedEntity ;
    rdfs:range ISO29110V2:AssessmentResult .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasBasePractice
ISO29110V2:hasBasePractice rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isBasePracticeOf ;
    rdfs:range ISO29110V2:BasePractice .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasCharacteristics
ISO29110V2:hasCharacteristics rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isCharacteristicsOf ;
