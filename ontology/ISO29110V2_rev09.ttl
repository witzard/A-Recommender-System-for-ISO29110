###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#PM.BP.22
ISO29110V2:PM.BP.22 rdf:type owl:NamedIndividual ,
        ISO29110V2:BasePractice ;
    ISO29110V2:hasOutputWorkProduct ISO29110V2:PM.OWP.01.02.WP10 ,
