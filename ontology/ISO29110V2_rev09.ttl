        ISO29110V2:WorkProductCharacteristic ;
    ISO29110V2:isCharacteristicsOf ISO29110V2:WP.16 ;
    ISO29110V2:hasWorkProductCharacteristicDetail "Textual and graphical information on the software structure" ;
    ISO29110V2:hasWorkProductCharacteristicID "WPC.15" ;
    ISO29110V2:hasWorkProductCharacteristicList "# Low-level or detailed software design\n- Provides detailed design (could be represented as a prototype, flow chart, entity-relationship diagram, pseudo-code, etc.)\n- Provides format of input/output data\n- Provides specification of data storage needs\n- Establishes required data naming conventions\n- Defines the format of required data structures\n- Defines the data fields and purpose of each required data element\n- Provides the specifications of the program structure" ;
    ISO29110V2:hasWorkProductCharacteristicName "Software Design" .

