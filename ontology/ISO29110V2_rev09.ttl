    ISO29110V2:hasTaskDescription "Verify the project repository recovery\nusing the project repository backup." ;
    ISO29110V2:hasTaskID "PM.2.7" ;
    ISO29110V2:hasTaskNote "NOTE: The verification is performed to check that the work products that have been backed up could be recovered." .


