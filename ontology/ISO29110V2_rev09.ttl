:iwp rdf:type ns1:Variable .

:n rdf:type ns1:Variable .

:note rdf:type ns1:Variable .

:owp rdf:type ns1:Variable .

:pj rdf:type ns1:Variable .

:po rdf:type ns1:Variable .

:pas rdf:type ns1:Variable .

:score rdf:type ns1:Variable .

:src rdf:type ns1:Variable .

:t rdf:type ns1:Variable .

:wp rdf:type ns1:Variable .

[ ns2:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "% <= 15 -> Not achieved" ;
   rdfs:label "RatingNotAchievedRule" ;
   rdf:type ns1:Imp ;
