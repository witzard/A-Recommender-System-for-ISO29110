#################################################################
#    Revision 2026-11-03 Round 3 (rev05): general axioms so the reasoner can detect data errors
#    - the 5 Rating individuals are pairwise different (with Functional hasDegreeAchievement: 2 ratings on one AssessmentResult = inconsistent)
#    - 16 top-level classes are pairwise disjoint (Consultant, RecommendedPractice, InputWorkProduct/OutputWorkProduct deliberately not included)
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( ISO29110V2:Completely_achieved ISO29110V2:Largely_achieved ISO29110V2:Partially_achieved ISO29110V2:Not_achieved ISO29110V2:Not_applicable )
] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ISO29110V2:Activity
                ISO29110V2:AssessedEntity
                ISO29110V2:AssessmentResult
                ISO29110V2:BasePractice
                ISO29110V2:Enterprise
                ISO29110V2:PreAssessment
                ISO29110V2:Process
                ISO29110V2:ProcessObjective
                ISO29110V2:ProcessOutcome
                ISO29110V2:Project
                ISO29110V2:Rating
                ISO29110V2:Role
                ISO29110V2:Task
                ISO29110V2:WorkProduct
                ISO29110V2:WorkProductCharacteristic
                ISO29110V2:WorkProductState
              )
] .



#################################################################
#    Revision 2026-11-03 Round 5 (rev06): recommendation vocabulary (approved 2026-11-03 23:42)
#################################################################

ISO29110V2:GapResult rdf:type owl:Class ;
    rdfs:subClassOf ISO29110V2:AssessmentResult ;
    rdfs:label "GapResult" ;
    rdfs:comment "Assessment result rated Not achieved or Partially achieved; inferred by GapNotAchievedRule / GapPartiallyAchievedRule (rev06b: SWRL instead of an equivalentClass with hasValue, to keep nominals out of the TBox for Pellet performance)." .

ISO29110V2:recommendTask rdf:type owl:ObjectProperty ;
    rdfs:domain ISO29110V2:AssessedEntity ; rdfs:range ISO29110V2:Task ;
    rdfs:comment "Inferred by RecommendTaskRule: ISO/IEC 29110 task that produces the work product with a gap." .

ISO29110V2:recommendOutcome rdf:type owl:ObjectProperty ;
    rdfs:domain ISO29110V2:AssessedEntity ; rdfs:range ISO29110V2:ProcessOutcome ;
    rdfs:comment "Inferred by RecommendOutcomeRule (rev08): process outcome of a base practice whose pre-assessment uses the work product with a gap (same BP -> WP evidence set as the advisor's Pre-Assessment sheet)." .

ISO29110V2:recommendBasePractice rdf:type owl:ObjectProperty ;
    rdfs:domain ISO29110V2:AssessedEntity ; rdfs:range ISO29110V2:BasePractice ;
    rdfs:comment "Inferred by RecommendBasePracticeRule (rev09): base practice whose pre-assessment (advisor BP-WP table) uses the work product with a gap." .

ISO29110V2:excludesWorkProduct rdf:type owl:ObjectProperty ;
    rdfs:domain ISO29110V2:Project ; rdfs:range ISO29110V2:WorkProduct ;
    rdfs:comment "Project profile entered by the consultant: work product NOT listed in the delivery instructions. Only conditional work products (ISO/IEC 29110 conditional tasks) are affected by ExcludedConditionalWorkProductRule." .

