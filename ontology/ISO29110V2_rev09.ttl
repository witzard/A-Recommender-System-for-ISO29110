###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasInputWorkProduct
ISO29110V2:hasInputWorkProduct rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isInputWorkProductOf ;
    rdfs:domain ISO29110V2:Task ;
    rdfs:range ISO29110V2:InputWorkProduct ,
        ISO29110V2:WorkProduct .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasOutputWorkProduct
ISO29110V2:hasOutputWorkProduct rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ISO29110V2:isOutputWorkProductOf ;
    rdfs:range ISO29110V2:OutputWorkProduct ,
        ISO29110V2:WorkProduct ;
    rdfs:domain [ rdf:type owl:Class ;
          owl:unionOf ( ISO29110V2:Task ISO29110V2:BasePractice )
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#hasProcess
