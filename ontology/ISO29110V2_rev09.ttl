    ISO29110V2:hasBasePracticeDescription "Document or update the Requirements Specification. Identify and\nconsult information sources (Customer, users, previous systems, documents,\netc.) in order to get new requirements. Analyse the identified requirements to\ndeterminate the Scope and feasibility.\nGenerate or update the Requirements Specification" ;
    ISO29110V2:hasBasePracticeID "SI.BP1" .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#SI.BP.02
ISO29110V2:SI.BP.02 rdf:type owl:NamedIndividual ,
        ISO29110V2:BasePractice ;
