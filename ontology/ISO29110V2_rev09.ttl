#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Activity
ISO29110V2:Activity rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty ISO29110V2:hasTask ;
                                      owl:someValuesFrom ISO29110V2:Task
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ISO29110V2:isActivityOf ;
                                      owl:someValuesFrom ISO29110V2:Process
                                    ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#AssessedEntity
ISO29110V2:AssessedEntity rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasAssessmentResult ;
                                            owl:someValuesFrom ISO29110V2:AssessmentResult
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:hasEntity ;
                                            owl:someValuesFrom ISO29110V2:WorkProduct
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isAssessedEntityOf ;
                                            owl:someValuesFrom ISO29110V2:PreAssessment
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:responsibleFor ;
                                            owl:someValuesFrom ISO29110V2:Project
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:recommend ;
                                            owl:someValuesFrom ISO29110V2:RecommendedPractice
                                          ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#AssessmentResult
ISO29110V2:AssessmentResult rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:hasDegreeAchievement ;
                                              owl:someValuesFrom ISO29110V2:Rating
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:isAssessmentResultOf ;
                                              owl:someValuesFrom ISO29110V2:AssessedEntity
                                            ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#BasePractice
ISO29110V2:BasePractice rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcessOutcome ;
          owl:someValuesFrom ISO29110V2:ProcessOutcome
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:isBasePracticeOf ;
          owl:someValuesFrom [ rdf:type owl:Class ;
                owl:unionOf ( ISO29110V2:PreAssessment ISO29110V2:Process )
              ]
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Consultant
ISO29110V2:Consultant rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty ISO29110V2:preAssess ;
                                        owl:someValuesFrom ISO29110V2:PreAssessment
                                      ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Enterprise
ISO29110V2:Enterprise rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty ISO29110V2:hasProject ;
                                        owl:someValuesFrom ISO29110V2:Project
                                      ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#InputWorkProduct
ISO29110V2:InputWorkProduct rdf:type owl:Class ;
    rdfs:subClassOf ISO29110V2:WorkProduct ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasApplicableState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasCharacteristics ;
          owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasCurrentState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasFinalState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcessOutcome ;
          owl:someValuesFrom ISO29110V2:ProcessOutcome
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:isWorkProductOf ;
          owl:someValuesFrom ISO29110V2:Process
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#OutputWorkProduct
ISO29110V2:OutputWorkProduct rdf:type owl:Class ;
    rdfs:subClassOf ISO29110V2:WorkProduct ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasApplicableState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasCharacteristics ;
          owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasCurrentState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasFinalState ;
          owl:someValuesFrom ISO29110V2:WorkProductState
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcessOutcome ;
          owl:someValuesFrom ISO29110V2:ProcessOutcome
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:isWorkProductOf ;
          owl:someValuesFrom ISO29110V2:Process
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#PreAssessment
ISO29110V2:PreAssessment rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasAssessedEntity ;
          owl:someValuesFrom ISO29110V2:AssessedEntity
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasBasePractice ;
          owl:someValuesFrom ISO29110V2:BasePractice
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcess ;
          owl:someValuesFrom ISO29110V2:Process
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:preAssessedBy ;
          owl:someValuesFrom ISO29110V2:Consultant
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Process
ISO29110V2:Process rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasActivity ;
          owl:someValuesFrom ISO29110V2:Activity
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasBasePractice ;
          owl:someValuesFrom ISO29110V2:BasePractice
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcessObjective ;
          owl:someValuesFrom ISO29110V2:ProcessObjective
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasProcessOutcome ;
          owl:someValuesFrom ISO29110V2:ProcessOutcome
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty ISO29110V2:hasWorkProduct ;
          owl:someValuesFrom ISO29110V2:WorkProduct
        ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#ProcessObjective
ISO29110V2:ProcessObjective rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty ISO29110V2:isProcessObjectiveOf ;
                                              owl:someValuesFrom ISO29110V2:Process
                                            ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#ProcessOutcome
ISO29110V2:ProcessOutcome rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty ISO29110V2:isProcessOutcomeOf ;
                                            owl:someValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( ISO29110V2:BasePractice
                                                                               ISO29110V2:InputWorkProduct
                                                                               ISO29110V2:OutputWorkProduct
                                                                               ISO29110V2:Process
                                                                             )
                                                               ]
                                          ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Project
ISO29110V2:Project rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:hasProcess ;
                                     owl:someValuesFrom ISO29110V2:Process
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:isProjectOf ;
                                     owl:someValuesFrom ISO29110V2:Enterprise
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ISO29110V2:isResponsibilityOf ;
                                     owl:someValuesFrom ISO29110V2:AssessedEntity
                                   ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Rating
ISO29110V2:Rating rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty ISO29110V2:isDegreeAchievementOf ;
                                    owl:someValuesFrom ISO29110V2:AssessmentResult
                                  ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#RecommendedPractice
ISO29110V2:RecommendedPractice rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty ISO29110V2:recommendedBy ;
                                                 owl:someValuesFrom ISO29110V2:AssessedEntity
                                               ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Role
ISO29110V2:Role rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:isRoleOf ;
                                  owl:someValuesFrom ISO29110V2:Task
                                ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#Task
ISO29110V2:Task rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasInputWorkProduct ;
                                  owl:someValuesFrom ISO29110V2:InputWorkProduct
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasOutputWorkProduct ;
                                  owl:someValuesFrom ISO29110V2:OutputWorkProduct
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:hasRole ;
                                  owl:someValuesFrom ISO29110V2:Role
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ISO29110V2:isTaskOf ;
                                  owl:someValuesFrom ISO29110V2:Activity
                                ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#WorkProduct
ISO29110V2:WorkProduct rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:hasApplicableState ;
                                         owl:someValuesFrom ISO29110V2:WorkProductState
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:hasCharacteristics ;
                                         owl:someValuesFrom ISO29110V2:WorkProductCharacteristic
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ISO29110V2:isWorkProductOf ;
                                         owl:someValuesFrom ISO29110V2:Process
                                       ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#WorkProductCharacteristic
ISO29110V2:WorkProductCharacteristic rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty ISO29110V2:isCharacteristicsOf ;
                                                       owl:someValuesFrom ISO29110V2:WorkProduct
                                                     ] .


###  http://www.semanticweb.org/mrwit/ontologies/2026/3/ISO29110V2#WorkProductState
ISO29110V2:WorkProductState rdf:type owl:Class .


